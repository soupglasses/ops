apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: rke2-host-ingress
spec:
  description: Permit only management, cluster, BGP, and essential ICMP traffic to the RKE2 host.
  nodeSelector:
    matchLabels:
      kubernetes.io/hostname: nas
  ingress:
    - fromEntities:
        - host
    - fromEntities:
        - cluster
      toPorts:
        - ports:
            - {port: "6443", protocol: TCP}
            - {port: "10250", protocol: TCP}
            - {port: "10257", protocol: TCP}
            - {port: "10259", protocol: TCP}
            - {port: "4240", protocol: TCP}
            - {port: "4244", protocol: TCP}
            - {port: "9100", protocol: TCP}
    - fromCIDR:
{% for cidr in host_firewall_ssh_ipv4 + host_firewall_ssh_ipv6 %}
        - {{ cidr }}
{% endfor %}
      toPorts:
        - ports:
            - {port: "22", protocol: TCP}
    - fromCIDR:
{% for cidr in host_firewall_management_ipv4 + host_firewall_management_ipv6 %}
        - {{ cidr }}
{% endfor %}
      toPorts:
        - ports:
            - {port: "6443", protocol: TCP}
            - {port: "9345", protocol: TCP}
            - {port: "10250", protocol: TCP}
    - fromCIDR:
        - {{ network_ipv4_gateway }}/32
        - {{ network_ipv6_gateway }}/128
      toPorts:
        - ports:
            - {port: "179", protocol: TCP}
    - icmps:
        - fields:
            - {family: IPv4, type: EchoRequest}
            - {family: IPv6, type: EchoRequest}
            - {family: IPv6, type: RouterAdvertisement}
            - {family: IPv6, type: NeighborSolicitation}
            - {family: IPv6, type: NeighborAdvertisement}
