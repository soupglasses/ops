{{/* SPDX-FileCopyrightText: 2026 Sofie Finnes <sofie+git@finnes.dev>
SPDX-License-Identifier: MIT */}}
{{- $xr := getCompositeResource . -}}
{{- $spec := $xr.spec -}}
{{- $namespace := $xr.metadata.namespace -}}
{{- $name := printf "oauth2-%s" $xr.metadata.uid -}}
{{- $dn := printf "oauthClientID=%s,%s" $spec.clientID __CLIENTS_DN_JSON__ -}}
{{- $public := eq $spec.tokenEndpointAuthMethod "none" -}}
{{- $extra := get . "extraResources" | default dict -}}
{{- if not $public }}
apiVersion: meta.gotemplating.fn.crossplane.io/v1alpha1
kind: ExtraResources
requirements:
  credentials:
    apiVersion: v1
    kind: Secret
    matchName: {{ $spec.clientSecretRef.name | quote }}
    namespace: {{ $namespace | quote }}
{{ printf "\n---\n" }}
{{- end }}
{{- if or $public (hasKey $extra "credentials") -}}
{{- $attributes := dict
    "objectClass" (list "oauthClient")
    "oauthClientName" (list ($spec.displayName | default $spec.clientID))
    "oauthRedirectURIs" $spec.redirectURIs
    "oauthGrantType" $spec.grantTypes
    "oauthResponseType" (list "code")
    "oauthScope" $spec.scopes
    "oauthTokenEndpointAuthMethod" (list $spec.tokenEndpointAuthMethod)
    "oauthIdTokenSignedResponseAlg" (list "RS256") -}}
{{- if $spec.postLogoutRedirectURIs -}}
{{- $_ := set $attributes "oauthPostLogoutRedirectURI" $spec.postLogoutRedirectURIs -}}
{{- end -}}
{{- if not $public -}}
{{- $items := (index $extra "credentials").items | default list -}}
{{- if ne (len $items) 1 -}}{{ fail "The local client credential Secret is missing" }}{{- end -}}
{{- $data := (index $items 0).resource.data -}}
{{- $encoded := get $data $spec.clientSecretRef.key | default "" -}}
{{- if eq $encoded "" -}}{{ fail "The local client credential Secret key is missing or empty" }}{{- end -}}
{{- $_ := set $attributes "oauthClientSecret" (list ($encoded | b64dec)) -}}
{{- end -}}
{{- $created := toDate "2006-01-02T15:04:05Z" $xr.metadata.creationTimestamp -}}
{{- $defaults := dict "oauthIssueDate" (list (date "20060102150405Z" $created)) "oauthAudience" (list $dn) -}}
apiVersion: v1
kind: Secret
metadata:
  name: {{ $name }}-attributes
  namespace: {{ $namespace }}
  annotations:
    {{ setResourceNameAnnotation "attributes" }}
    gotemplating.fn.crossplane.io/ready: "True"
  labels:
    identity.ops.finnes.dev/client-uid: {{ $xr.metadata.uid | quote }}
type: Opaque
data:
  attributes.json: {{ $attributes | mustToJson | b64enc | quote }}
  defaults.json: {{ $defaults | mustToJson | b64enc | quote }}
{{ printf "\n---\n" }}
apiVersion: ldap.ops.finnes.dev/v1alpha1
kind: Entry
metadata:
  name: {{ $name }}
  namespace: {{ $namespace }}
  labels:
    identity.ops.finnes.dev/client-uid: {{ $xr.metadata.uid | quote }}
  annotations:
    {{ setResourceNameAnnotation "ldap-entry" }}
    crossplane.io/external-name: {{ $dn | quote }}
    gotemplating.fn.crossplane.io/ready: {{ ternary "True" "False" (and (eq (getResourceCondition "Ready" (getComposedResource . "ldap-entry")).Status "True") (eq (getResourceCondition "Synced" (getComposedResource . "ldap-entry")).Status "True")) | quote }}
spec:
  managementPolicies: [Observe, Create, Update]
  providerConfigRef:
    kind: {{ $spec.backendRef.kind | default "ClusterProviderConfig" }}
    name: {{ $spec.backendRef.name | quote }}
  forProvider:
    dataJsonSecretRef:
      name: {{ $name }}-attributes
      key: attributes.json
    dataJsonCreateDefaultsSecretRef:
      name: {{ $name }}-attributes
      key: defaults.json
    restrictAttributes:
      - objectClass
      - oauthClientName
      - oauthRedirectURIs
      - oauthPostLogoutRedirectURI
      - oauthGrantType
      - oauthResponseType
      - oauthScope
      - oauthTokenEndpointAuthMethod
      - oauthClientSecret
      - oauthIdTokenSignedResponseAlg
{{- end }}
