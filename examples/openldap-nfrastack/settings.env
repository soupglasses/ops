DOMAIN=finnes.dev
BASE_DN=dc=finnes,dc=dev
ORGANIZATION=Finnes
# Upstream temporarily starts ldap://$HOSTNAME during bootstrap. Confine that
# listener to loopback; only the final LDAPS listener is reachable by other pods.
HOSTNAME=127.0.0.1
ADMIN_PASS_FILE=/test-secrets/admin
CONFIG_PASS_FILE=/test-secrets/config
ADD_DEFAULT_DATA=FALSE
ENABLE_BACKUP=FALSE
ENABLE_SASLAUTHD=FALSE
ENABLE_TLS=TRUE
SLAPD_HOSTS=ldaps:/// ldapi:///
TLS_ENFORCE=TRUE
# No client certificate is required for password binds. Clients must still
# verify ldap.finnes.dev against their trusted CA; this is a server-side setting.
TLS_VERIFY_CLIENT=never
TLS_CREATE_CA=FALSE
TLS_ENABLE_DH_PARAM=FALSE
TLS_RESET_PERMISSIONS=FALSE
TLS_CERT_FILE=tls.crt
TLS_KEY_FILE=tls.key
TLS_CA_CERT_PATH=/etc/ssl/certs
TLS_CA_CERT_FILE=ca-certificates.crt
LOG_TYPE=CONSOLE
CONTAINER_ENABLE_SCHEDULING=FALSE
CONTAINER_ENABLE_MESSAGING=FALSE
CONTAINER_ENABLE_MONITORING=FALSE
