# Unix peer credentials remain usable for local administration; network simple
# binds require encryption. Client trust is validated by clients, not disabled.
dn: cn=config
changetype: modify
replace: olcTLSCertificateFile
olcTLSCertificateFile: /certs/tls.crt
-
replace: olcTLSCertificateKeyFile
olcTLSCertificateKeyFile: /certs/tls.key
-
replace: olcTLSCACertificateFile
olcTLSCACertificateFile: /etc/ssl/certs/ca-certificates.crt
-
replace: olcTLSProtocolMin
olcTLSProtocolMin: 3.3
-
replace: olcLocalSSF
olcLocalSSF: 128
-
replace: olcSecurity
olcSecurity: simple_bind=128

dn: olcDatabase={-1}frontend,cn=config
changetype: modify
replace: olcPasswordHash
olcPasswordHash: {ARGON2}

# Configuration administration uses the local Unix socket, never a default
# network-accessible cn=config password.
dn: olcDatabase={0}config,cn=config
changetype: modify
replace: olcRootPW
-
replace: olcAccess
olcAccess: {0}to dn.exact="cn=config" attrs=olcTLSCertificateFile,olcTLSCertificateKeyFile
  by dn.exact="gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth" manage
  by dn.exact="gidNumber=389+uidNumber=389,cn=peercred,cn=external,cn=auth" write
  by * none
olcAccess: {1}to *
  by dn.exact="gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth" manage
  by * none

# RootDN (currently Canaille and Terraform) retains its implicit administrative
# rights. Application readers are explicitly delegated through ldap-readers.
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword by self =w by anonymous auth by * none
olcAccess: {1}to dn.subtree="ou=users,dc=finnes,dc=dev" attrs=entry,objectClass,uid,cn,sn,givenName,displayName,mail,memberOf,entryUUID,modifyTimestamp
  by group.exact="cn=ldap-readers,ou=groups,dc=finnes,dc=dev" read
  by self read
  by * none
olcAccess: {2}to dn.subtree="ou=groups,dc=finnes,dc=dev" attrs=entry,objectClass,cn,description,member,entryUUID,modifyTimestamp
  by group.exact="cn=ldap-readers,ou=groups,dc=finnes,dc=dev" read
  by * none
olcAccess: {3}to * by * none
-
replace: olcDbIndex
olcDbIndex: objectClass eq
olcDbIndex: uid,mail,cn eq
olcDbIndex: member,memberOf eq
olcDbIndex: entryUUID eq
