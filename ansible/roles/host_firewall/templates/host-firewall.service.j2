# The distribution's nftables.service flushes every table, including those of Cilium and kubelet.
[Unit]
Description=Filter traffic to the host
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
After=systemd-modules-load.service local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft --file /etc/host-firewall.nft
ExecReload=/usr/sbin/nft --file /etc/host-firewall.nft
ExecStop=/usr/sbin/nft destroy table inet host_firewall

[Install]
WantedBy=sysinit.target
