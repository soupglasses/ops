[Unit]
Description=Encrypt and restore-verify an off-cluster etcd snapshot
After=network-online.target rke2-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/rke2-restic-backup --local
TimeoutStartSec=30m
Nice=10
IOSchedulingClass=best-effort
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER
LockPersonality=true
NoNewPrivileges=true
# Read-only dataset identity checks need the ZFS ioctl device.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/zfs rw
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rke2-restic-backup /var/lib/prometheus/node-exporter
ReadWritePaths=/var/lib/rancher/rke2/server/db/snapshots
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
