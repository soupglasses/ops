{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  rebaseWhen: "conflicted",
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  ignorePaths: [
    "**/*.sops.*",
    "kubernetes/clusters/*/flux-system/**",
  ],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
  },
  kustomize: {
    managerFilePatterns: ["/(^|/)kustomization\\.ya?ml$/"],
  },
  packageRules: [
    {
      description: "Review Jellyfin plugin upgrades with the tested runtime build",
      matchPackageNames: ["jellyfin/jellyfin-plugin-ldapauth"],
      automerge: false,
      pinDigests: true,
    },
    {
      description: "Vector tag and digest are updated together by its regex manager",
      matchFileNames: ["kubernetes/apps/monitoring/log-collector/app/helmrelease.yaml"],
      matchManagers: ["flux", "helm-values"],
      matchPackageNames: ["docker.io/timberio/vector", "timberio/vector"],
      enabled: false,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      description: "Review hook compatibility after the earlier pre-commit rollback",
      matchPackageNames: ["pre-commit/pre-commit"],
      matchManagers: ["mise"],
      automerge: false,
    },
    {
      description: "Review the bundled network stack before scheduling node maintenance",
      matchPackageNames: ["rancher/rke2", "kubernetes-sigs/gateway-api"],
      groupName: "RKE2 and Gateway API",
      dependencyDashboardApproval: false,
      automerge: false,
    },
    {
      description: "Update application charts and their explicitly pinned images together",
      matchFileNames: ["kubernetes/apps/monitoring/victoria-metrics/app/helmrelease.yaml"],
      groupName: "VictoriaMetrics stack",
    },
    {
      matchFileNames: ["kubernetes/apps/monitoring/victoria-logs/app/helmrelease.yaml"],
      groupName: "VictoriaLogs",
    },
    {
      matchFileNames: ["kubernetes/apps/default/minecraft/app/helmrelease.yaml"],
      groupName: "Minecraft",
    },
    {
      matchFileNames: ["kubernetes/apps/openebs-system/openebs/app/helmrelease.yaml"],
      groupName: "OpenEBS",
    },
    {
      matchFileNames: ["kubernetes/apps/monitoring/log-collector/app/helmrelease.yaml"],
      groupName: "Vector",
    },
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "( {{currentVersion}} -> {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "( {{currentVersion}} -> {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "( {{currentVersion}} -> {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      commitMessageExtra: "( {{currentDigestShort}} -> {{newDigestShort}} )",
    },
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchDatasources: ["helm"],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
    },
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
  ],
  customManagers: [
    {
      description: "Jellyfin LDAP release and verified archive checksum",
      customType: "regex",
      managerFilePatterns: ["/^packages/jellyfin-runtime/plugins\\.lock\\.json$/"],
      matchStrings: [
        '"repository":\\s*"(?<depName>jellyfin/jellyfin-plugin-ldapauth)"[\\s\\S]*?"tag":\\s*"(?<currentValue>v[0-9]+)"\\s*,\\s*"sha256":\\s*"(?<currentDigest>[a-f0-9]{64})"',
      ],
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "loose",
    },
    {
      description: "Kubernetes editor schemas follow the grouped RKE2 release",
      customType: "regex",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "yaml-language-server: \\$schema=https://raw\\.githubusercontent\\.com/yannh/kubernetes-json-schema/[^/]+/(?<currentValue>v\\d+\\.\\d+\\.\\d+)[/-]"
      ],
      depNameTemplate: "rancher/rke2",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)\\+rke2r\\d+$",
      versioningTemplate: "semver"
    },
    {
      description: "Vector image tag and digest, keeping its version label valid",
      customType: "regex",
      managerFilePatterns: [
        "/kubernetes/apps/monitoring/log-collector/app/helmrelease\\.yaml$/"
      ],
      matchStrings: [
        "repository: (?<depName>docker\\.io/timberio/vector)\\n      tag: (?<currentValue>\\S+)\\n      digest: (?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker"
    },
    {
      description: "RKE2 release and Linux amd64 archive checksum",
      customType: "regex",
      managerFilePatterns: [
        "/ansible/inventories/home/group_vars/all/main\\.yml$/"
      ],
      matchStrings: [
        "rke2_version: (?<currentValue>\\S+)\\nrke2_tarball_sha256: (?<currentDigest>[a-f0-9]{64})"
      ],
      depNameTemplate: "rancher/rke2",
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+rke2r(?<build>\\d+)$"
    },
    {
      description: "Gateway API CRD release tags and immutable commit references",
      customType: "regex",
      managerFilePatterns: [
        "/kubernetes/apps/network/cilium-gateway/crds/kustomization\\.yaml$/"
      ],
      matchStrings: [
        "https://raw\\.githubusercontent\\.com/kubernetes-sigs/gateway-api/(?<currentDigest>[a-f0-9]{40})/[^\\s]+ # (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      depNameTemplate: "kubernetes-sigs/gateway-api",
      datasourceTemplate: "github-tags"
    },
    {
      description: "VictoriaLogs Grafana plugin",
      customType: "regex",
      managerFilePatterns: [
        "/kubernetes/apps/monitoring/victoria-metrics/app/helmrelease\\.yaml$/"
      ],
      matchStrings: [
        "victoriametrics-logs-datasource@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      depNameTemplate: "VictoriaMetrics/victorialogs-datasource",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$"
    },
    {
      description: "Annotated Mise backends without native Renovate support",
      customType: "regex",
      managerFilePatterns: [
        "/(^|/)\\.mise\\.toml$/"
      ],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\"krew:[^\"]+\" = \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      description: "Process annotated dependencies",
      customType: "regex",
      managerFilePatterns: [
        "/(^|/).+\\.env$/",
        "/(^|/).+\\.sh$/",
        "/(^|/).+\\.ya?ml$/",
      ],
      matchStrings: [
        // # renovate: datasource=github-releases depName=k3s-io/k3s
        // k3s_release_version: &version v1.29.0+k3s1
        // # renovate: datasource=helm depName=cilium repository=https://helm.cilium.io
        // version: 1.15.1
        // # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
        // KUBERNETES_VERSION=v1.31.1
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        // # renovate: datasource=docker depName=ghcr.io/prometheus-operator/prometheus-operator
        // https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.80.0/example/prometheus-operator-crd/monitoring.coreos.com_alertmanagerconfigs.yaml
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
  ],
}
