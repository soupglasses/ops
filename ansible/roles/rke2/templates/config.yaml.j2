profile: cis
cni: cilium
disable-kube-proxy: true
disable:
  - rke2-ingress-nginx
secrets-encryption: true
protect-kernel-defaults: true
write-kubeconfig-mode: "0640"
node-name: nas
node-ip:
  - {{ network_ipv4_address.split('/')[0] }}
  - {{ network_ipv6_address.split('/')[0] }}
cluster-cidr:
{% for cidr in rke2_cluster_cidrs %}
  - {{ cidr }}
{% endfor %}
service-cidr:
{% for cidr in rke2_service_cidrs %}
  - {{ cidr }}
{% endfor %}
tls-san:
{% for san in rke2_tls_sans %}
  - {{ san }}
{% endfor %}
etcd-snapshot-schedule-cron: "{{ rke2_etcd_snapshot_schedule }}"
etcd-snapshot-retention: {{ rke2_etcd_snapshot_retention }}
etcd-snapshot-compress: true
# Backups are encrypted and restore-verified by the host restic timer.
etcd-s3: false
etcd-disable-snapshots: true
{% if rke2_token | length > 0 %}
token: {{ rke2_token | to_json }}
{% endif %}
