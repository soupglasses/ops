# Git credential protocol; only GitHub HTTPS requests use this broker.
set -eu
case "${1:-}" in get) ;; store|erase) exit 0 ;; *) exit 1 ;; esac
protocol=
host=
while IFS= read -r line && [ -n "$line" ]; do
    case "$line" in
        protocol=*) protocol=${line#protocol=} ;;
        host=*) host=${line#host=} ;;
    esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
export OIDC_SOCK=/run/soupbot-github/oidc-agent.sock
token=$(/usr/bin/timeout --kill-after=5s 40s /usr/bin/oidc-token \
    github --time=300 --name=git)
[ -n "$token" ] || exit 1
printf 'username=x-access-token\npassword=%s\n\n' "$token"
